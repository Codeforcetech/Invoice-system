generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  name                   String
  email                  String                  @unique
  passwordHash           String
  role                   UserRole                @default(USER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  companies              Company[]
  invoices               Invoice[]               @relation("UserInvoices")
  itemTemplates          InvoiceItemTemplate[]
  mailTemplates          MailTemplate[]
  systemSetting          SystemSetting?
  expenses               Expense[]
  accounting             AccountingSetting?
  accounts               Account[]
  journals               JournalEntry[]
  feeds                  StatementFeed[]
  claimWorkspace         ClaimWorkspace?         @relation("ClaimOwner")
  claimMemberships       ClaimMember[]
  submitterProfile       SubmitterProfile?
  submissionsOwned       Submission[]            @relation("SubmissionOwner")
  submissionsMade        Submission[]            @relation("SubmissionSubmitter")
  submissionLinks        SubmissionLink[]        @relation("LinkOwner")
  claimsSubmitted        ExpenseClaim[]          @relation("ClaimApplicant")
  claimEvents            ClaimEvent[]
  notifications          AppNotification[]
  notificationPreference NotificationPreference?
  fixedAssets            FixedAsset[]
  reportAnnotations      ReportAnnotation[]
  workspaceMembers       WorkspaceMember[]       @relation("WorkspaceOwner")
  workspaceMembership    WorkspaceMember?        @relation("WorkspaceMemberUser")
  auditLogsOwned         AuditLog[]              @relation("AuditOwner")
  auditLogsActed         AuditLog[]              @relation("AuditActor")
  evidenceOwned          EvidenceFile[]          @relation("EvidenceOwner")
}

// A workspace is identified by its owner's user id, so existing ownership columns
// keep working. A user is a member of at most one workspace; the owner is implicitly ADMIN.
model WorkspaceMember {
  id        String   @id @default(cuid())
  ownerId   String
  userId    String   @unique
  role      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  user      User     @relation("WorkspaceMemberUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([ownerId, active])
}

// Append-only record of who did what in a workspace.
model AuditLog {
  id        String   @id @default(cuid())
  ownerId   String
  actorId   String
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())
  owner     User     @relation("AuditOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ownerId, createdAt])
  @@index([ownerId, entity, entityId])
}

// Reporting metadata; source records and accounting amounts are never changed.
model ReportAnnotation {
  userId            String
  targetType        String
  targetId          String
  department        String    @default("")
  office            String    @default("")
  plannedDate       DateTime? @db.Date
  bankCode          String    @default("")
  branchCode        String    @default("")
  bankAccountType   String    @default("")
  bankAccountNumber String    @default("")
  bankAccountHolder String    @default("")
  version           Int       @default(1)
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([userId, department, office])
}

model FixedAsset {
  id               String                @id
  userId           String
  name             String
  acquiredDate     DateTime              @db.Date
  serviceDate      DateTime              @db.Date
  cost             Int
  usefulLife       Int
  method           String
  fiscalStartMonth Int                   @default(1)
  assetAccountId   String
  expenseAccountId String
  note             String                @default("")
  archived         Boolean               @default(false)
  revision         Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetAccount     Account               @relation("FixedAssetAccount", fields: [userId, assetAccountId], references: [userId, id])
  expenseAccount   Account               @relation("DepreciationAccount", fields: [userId, expenseAccountId], references: [userId, id])
  postings         DepreciationPosting[]

  @@unique([userId, id])
  @@index([userId, archived, createdAt])
}

model DepreciationPosting {
  id             String       @id @default(cuid())
  userId         String
  assetId        String
  entryId        String
  month          String
  amount         Int
  active         Boolean      @default(true)
  canceledReason String?
  canceledAt     DateTime?
  createdAt      DateTime     @default(now())
  asset          FixedAsset   @relation(fields: [userId, assetId], references: [userId, id])
  entry          JournalEntry @relation(fields: [userId, entryId], references: [userId, id])

  @@unique([assetId, month, entryId])
  @@index([userId, assetId, active, month])
}

model Company {
  id             String                  @id @default(cuid())
  name           String
  invoiceCode    String
  userId         String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  billingCcEmail String?
  billingEmail   String?
  commonSubject  String?
  defaultDueDays Int                     @default(30)
  paymentTerms   String?
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  sequences      InvoiceNumberSequence[]

  @@unique([userId, invoiceCode])
  @@index([userId])
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique
  companyId          String
  subject            String
  issueDate          DateTime
  dueDate            DateTime
  subtotal           Int
  taxRate            Int
  taxAmount          Int
  totalWithTax       Int
  withholdingEnabled Boolean       @default(false)
  withholdingTax     Int
  grandTotal         Int
  status             InvoiceStatus @default(DRAFT)
  receivedDate       DateTime?     @db.Date
  receiptMatchId     String?
  mergedIntoId       String?
  recurringKey       String?       @unique
  createdById        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  autosaveUpdatedAt  DateTime?
  /// * ログイン不要の帳票共有用トークン
  shareToken         String?       @unique
  company            Company       @relation(fields: [companyId], references: [id])
  createdBy          User          @relation("UserInvoices", fields: [createdById], references: [id])
  items              InvoiceItem[]

  @@index([createdById])
  @@index([companyId])
  @@index([issueDate])
  @@index([status])
  @@index([withholdingEnabled])
}

model InvoiceItem {
  id                   String   @id @default(cuid())
  invoiceId            String
  sortOrder            Int
  productName          String
  unit                 String?
  quantity             Decimal  @db.Decimal(12, 2)
  unitPrice            Int
  amount               Int
  amountManuallyEdited Boolean  @default(false)
  /// 消費税区分。null は請求書の税率を引き継ぐ（従来動作）
  taxCategory          String?
  note                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, sortOrder])
  @@index([invoiceId])
}

/// ユーザーごとの明細テンプレート（よく使う行をワンクリック追加）
model InvoiceItemTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  productName String
  unit        String?
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Int
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// ユーザーごとのメールテンプレート（変数差し込みは {{key}} 形式）
model MailTemplate {
  id              String   @id @default(cuid())
  userId          String
  name            String
  subjectTemplate String
  bodyTemplate    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemSetting {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  companyName               String
  invoiceRegistrationNumber String?
  postalCode                String?
  address                   String?
  phone                     String?
  email                     String?
  contactPerson             String?
  stampImageUrl             String?
  bankName                  String?
  branchName                String?
  accountType               String?
  accountNumber             String?
  accountHolder             String?
  accountHolderKana         String?
  transferNote              String?
  taxRate                   Int      @default(1000)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvoiceNumberSequence {
  id        String   @id @default(cuid())
  companyId String
  yearMonth String
  lastSeq   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, yearMonth])
  @@index([companyId])
}

enum UserRole {
  USER
  ADMIN
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  ISSUED
}

model Expense {
  id           String             @id @default(cuid())
  userId       String
  supplier     String
  description  String
  category     String
  /// 課税仕入などの消費税区分。null は未設定
  taxCategory  String?
  amount       Int
  costMonth    String
  dueDate      DateTime           @db.Date
  paidDate     DateTime?          @db.Date
  note         String             @default("")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment   ExpenseAttachment?
  /// 業務委託メンバーの提出を承認して作られた支払いのとき、その提出
  submissionId String?
  submission   Submission?        @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([userId, costMonth])
  @@index([submissionId])
  @@index([userId, paidDate, dueDate])
}

model ExpenseAttachment {
  expenseId String  @id
  filename  String
  data      Bytes
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model AccountingSetting {
  userId    String   @id
  startDate DateTime @db.Date
  industry  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                   String          @id @default(cuid())
  userId               String
  code                 String
  name                 String
  kind                 String
  active               Boolean         @default(true)
  system               Boolean         @default(false)
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines                JournalLine[]
  feeds                StatementFeed[]
  rules                StatementRule[]
  assetAccounts        FixedAsset[]    @relation("FixedAssetAccount")
  depreciationAccounts FixedAsset[]    @relation("DepreciationAccount")

  @@unique([userId, code])
  @@unique([userId, id])
}

model JournalEntry {
  id         String        @id @default(cuid())
  userId     String
  requestKey String
  date       DateTime      @db.Date
  memo       String
  source     String        @default("MANUAL")
  sourceId   String?
  reversalOf String?       @unique
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines      JournalLine[]

  statementRows        StatementRow[]
  expenseClaims        ExpenseClaim[]        @relation("ClaimPosting")
  paidClaims           ExpenseClaim[]        @relation("ClaimPayment")
  depreciationPostings DepreciationPosting[]

  @@unique([userId, requestKey])
  @@unique([userId, id])
  @@index([userId, date, createdAt])
}

model JournalLine {
  id          String       @id @default(cuid())
  userId      String
  entryId     String
  accountId   String
  debit       Int          @default(0)
  credit      Int          @default(0)
  /// 消費税区分。null は未設定（既存の仕訳・区分を指定しない仕訳）
  taxCategory String?
  entry       JournalEntry @relation(fields: [userId, entryId], references: [userId, id], onDelete: Cascade)
  account     Account      @relation(fields: [userId, accountId], references: [userId, id])

  @@index([userId, accountId])
}

model AccountingSource {
  userId      String
  key         String
  fingerprint String
  entryId     String?

  @@id([userId, key])
}

model ReceiptMatch {
  id          String    @id
  userId      String
  date        DateTime  @db.Date
  amount      Int
  payer       String
  invoiceIds  Json
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model RecurringInvoice {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  name      String
  snapshot  Json
  nextMonth String
  issueDay  Int
  dueDays   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, active, nextMonth])
}

model StatementFeed {
  id        String          @id @default(cuid())
  userId    String
  name      String
  kind      String
  accountId String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account         @relation(fields: [userId, accountId], references: [userId, id])
  rows      StatementRow[]
  rules     StatementRule[]

  @@unique([userId, id])
  @@unique([userId, name])
}

model StatementRow {
  id          String        @id @default(cuid())
  userId      String
  feedId      String
  fingerprint String
  date        DateTime      @db.Date
  description String
  amount      Int
  reference   String?
  status      String        @default("PENDING")
  entryId     String?
  decision    String?
  fileName    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  feed        StatementFeed @relation(fields: [userId, feedId], references: [userId, id], onDelete: Cascade)

  entry JournalEntry? @relation(fields: [userId, entryId], references: [userId, id], onDelete: Restrict)

  @@unique([feedId, entryId])
  @@unique([userId, feedId, fingerprint])
  @@index([userId, feedId, status, date])
}

model StatementRule {
  id               String        @id @default(cuid())
  userId           String
  feedId           String
  descriptionKey   String
  direction        String
  counterAccountId String
  automatic        Boolean       @default(false)
  active           Boolean       @default(true)
  updatedAt        DateTime      @updatedAt
  feed             StatementFeed @relation(fields: [userId, feedId], references: [userId, id], onDelete: Cascade)
  counterAccount   Account       @relation(fields: [userId, counterAccountId], references: [userId, id])

  @@unique([userId, feedId, descriptionKey, direction])
}

model ClaimWorkspace {
  ownerId String         @id
  name    String
  owner   User           @relation("ClaimOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members ClaimMember[]
  claims  ExpenseClaim[]
}

model ClaimMember {
  id        String         @id @default(cuid())
  ownerId   String
  userId    String
  role      String
  active    Boolean        @default(true)
  updatedAt DateTime       @updatedAt
  workspace ClaimWorkspace @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([ownerId, userId])
  @@index([userId, active])
}

model ExpenseClaim {
  id             String         @id
  ownerId        String
  applicantId    String
  title          String
  merchant       String
  date           DateTime       @db.Date
  amount         Int
  category       String
  note           String
  status         String         @default("DRAFT")
  revision       Int            @default(0)
  entryId        String?
  paymentEntryId String?
  paidDate       DateTime?      @db.Date
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workspace      ClaimWorkspace @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict)
  applicant      User           @relation("ClaimApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  receipt        ClaimReceipt?
  events         ClaimEvent[]

  entry        JournalEntry? @relation("ClaimPosting", fields: [ownerId, entryId], references: [userId, id], onDelete: Restrict, map: "ExpenseClaim_entry_owner_fkey")
  paymentEntry JournalEntry? @relation("ClaimPayment", fields: [ownerId, paymentEntryId], references: [userId, id], onDelete: Restrict, map: "ExpenseClaim_payment_owner_fkey")

  @@index([ownerId, status, date])
  @@index([applicantId, updatedAt])
}

model ClaimReceipt {
  claimId  String       @id
  filename String
  mimeType String
  data     Bytes
  claim    ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model ClaimEvent {
  id        String       @id @default(cuid())
  claimId   String
  actorId   String
  action    String
  comment   String
  revision  Int
  createdAt DateTime     @default(now())
  claim     ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  actor     User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([claimId, createdAt])
}

model AppNotification {
  id                  String    @id @default(cuid())
  userId              String
  eventKey            String
  title               String
  href                String
  readAt              DateTime?
  emailStatus         String    @default("DISABLED")
  emailPayload        Json?
  emailAttempts       Int       @default(0)
  emailFirstAttemptAt DateTime?
  emailLastAttemptAt  DateTime?
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, createdAt])
  @@index([emailStatus, createdAt])
}

model NotificationPreference {
  userId       String  @id
  emailEnabled Boolean @default(false)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 電子取引の証憑（領収書・請求書など）。ファイルは受け取ったまま保存し、後から変更・削除できない。
// 取引年月日・金額・取引先で検索できる。訂正と無効化は EvidenceHistory に残る。
model EvidenceFile {
  id              String            @id @default(cuid())
  ownerId         String
  kind            String
  transactionDate DateTime          @db.Date
  amount          Int
  counterparty    String
  /// 検索用に正規化した取引先（全角半角・大小文字・空白をそろえたもの）
  counterpartyKey String
  memo            String            @default("")
  filename        String
  mimeType        String
  size            Int
  sha256          String
  data            Bytes
  status          String            @default("ACTIVE")
  voidReason      String?
  voidedAt        DateTime?
  voidedById      String?
  uploadedById    String
  /// 取り込み元（支払いの添付PDFなど）。同じ元を二重に取り込まないために使う
  sourceType      String?
  sourceId        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           User              @relation("EvidenceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  history         EvidenceHistory[]

  @@unique([ownerId, sourceType, sourceId])
  @@index([ownerId, transactionDate])
  @@index([ownerId, amount])
  @@index([ownerId, counterpartyKey])
}

// 追記専用。登録・訂正・無効化の履歴。
model EvidenceHistory {
  id         String       @id @default(cuid())
  evidenceId String
  ownerId    String
  actorId    String
  action     String
  reason     String       @default("")
  before     Json?
  after      Json?
  createdAt  DateTime     @default(now())
  evidence   EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([evidenceId, createdAt])
  @@index([ownerId, createdAt])
}

// Failed sign-in counter per e-mail address (hashed), kept for accounts that do not exist as well,
// so the response never reveals whether an account exists.
model LoginThrottle {
  key           String    @id
  failures      Int       @default(0)
  firstFailedAt DateTime  @default(now())
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt
}

/// 業務委託メンバー（提出者）が自分の情報として設定する、請求書の差出人の情報
model SubmitterProfile {
  userId             String   @id
  ownerId            String
  legalName          String
  address            String   @default("")
  phone              String   @default("")
  registrationNumber String   @default("")
  bankName           String   @default("")
  branchName         String   @default("")
  accountType        String   @default("")
  accountNumber      String   @default("")
  accountHolder      String   @default("")
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 業務委託メンバーが提出する報酬の請求書（領収書つき）。管理者が承認すると、支払管理に反映される。
model Submission {
  id                 String            @id
  ownerId            String
  /// メンバー（提出者）が提出したときのみ。外部リンク経由の提出は空（linkId が入る）
  submitterId        String?
  /// 外部の提出リンク経由のとき、そのリンク
  linkId             String?
  /// 外部の人が、承認・差戻しの連絡を受け取るメールアドレス（任意）
  contactEmail       String?
  /// 何月分か（YYYY-MM）
  month              String
  title              String
  note               String            @default("")
  /// DRAFT 下書き / SUBMITTED 承認待ち / APPROVED 承認済み / REJECTED 差戻し
  status             String            @default("DRAFT")
  revision           Int               @default(0)
  subtotal           Int               @default(0)
  taxAmount          Int               @default(0)
  total              Int               @default(0)
  /// 提出時点の差出人の情報（あとでプロフィールを変えても、提出した内容は変わらない）
  senderName         String            @default("")
  senderAddress      String            @default("")
  senderRegistration String            @default("")
  senderBank         String            @default("")
  rejectReason       String?
  decidedById        String?
  decidedAt          DateTime?
  submittedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  owner              User              @relation("SubmissionOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  submitter          User?             @relation("SubmissionSubmitter", fields: [submitterId], references: [id], onDelete: Restrict)
  link               SubmissionLink?   @relation(fields: [linkId], references: [id], onDelete: Restrict)
  items              SubmissionItem[]
  files              SubmissionFile[]
  events             SubmissionEvent[]
  expenses           Expense[]

  @@index([ownerId, status, month])
  @@index([submitterId, updatedAt])
  @@index([linkId, status])
}

model SubmissionItem {
  id           String     @id @default(cuid())
  submissionId String
  sortOrder    Int
  /// REWARD 報酬 / TRANSPORT 交通費 / EXPENSE その他の経費
  kind         String
  name         String
  quantity     Decimal    @db.Decimal(12, 2)
  unitPrice    Int
  /// 税抜の金額（単価 × 数量）
  amount       Int
  taxCategory  String
  note         String     @default("")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  filename     String
  mimeType     String
  size         Int
  sha256       String
  data         Bytes
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model SubmissionEvent {
  id           String     @id @default(cuid())
  submissionId String
  actorId      String
  action       String
  note         String     @default("")
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

/// 外部の人（ログインなし）が、請求書と領収書を提出するためのリンク。相手ごとに1本。
/// トークンそのものは保存せず、ハッシュだけを保存する（発行時に1回だけ表示する）。
model SubmissionLink {
  id              String       @id
  ownerId         String
  createdById     String
  /// 宛名・メモ（管理者だけが見る。相手の画面には「○○様」として出る）
  label           String
  tokenHash       String       @unique
  /// 一覧で見分けるための、トークンの末尾4文字
  tokenHint       String
  expiresAt       DateTime
  revokedAt       DateTime?
  /// 承認待ちの同時件数の上限
  maxPending      Int          @default(3)
  /// このリンクからの提出の合計の上限
  maxSubmissions  Int          @default(20)
  submissionCount Int          @default(0)
  /// AIの読み取りを使える回数
  aiReadsLimit    Int          @default(5)
  aiReadsUsed     Int          @default(0)
  /// 前回入力した差出人の情報（次回の入力を楽にするため）
  profile         Json?
  lastUsedAt      DateTime?
  createdAt       DateTime     @default(now())
  owner           User         @relation("LinkOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  submissions     Submission[]

  @@index([ownerId, createdAt])
}

/// ログインなしの入口で、短時間の大量アクセスを止めるための数え上げ（キーはIP等のハッシュ）。
model PublicThrottle {
  key         String   @id
  windowStart DateTime
  count       Int
}
