# PostgreSQL connection; use separate local/test and production databases.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/invoice"
# Generate a long random secret; never commit a real value.
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Google OAuth Web Application client ID (public, not a client secret).
# Enable Gmail API and register the exact JavaScript origin in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Optional transactional notifications. Server-side only; do not expose as NEXT_PUBLIC.
# Use a verified Resend sending address and the HTTPS URL of this app.
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL=""
NOTIFICATION_APP_URL=""
# At least 32 random characters. Authorizes POST /api/internal/notifications/send.
# Configure an external worker to call the endpoint periodically for queued/retry messages.
NOTIFICATION_JOB_SECRET=""
