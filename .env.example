# PostgreSQL connection (PostgreSQL 16). Use separate local/test and production databases.
# For docker-compose.dev.yml: postgresql://postgres:dev-only-password@127.0.0.1:5433/seiq_dev
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/invoice"
# Signs the session cookie. At least 32 random characters in production (the app refuses to start
# with a shorter one there). Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"
# Not read by the code today; kept for deployment tooling.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Google OAuth Web Application client ID (public, not a client secret). Used for creating Gmail drafts.
# Enable the Gmail API and register the exact JavaScript origin of this app in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Optional transactional notifications (e-mail copies of in-app notifications).
# Server-side only; do not expose as NEXT_PUBLIC. Use a verified Resend sending address and the
# HTTPS URL of this app. Without them, notifications stay in the app and no e-mail is sent.
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL=""
NOTIFICATION_APP_URL=""
# At least 32 random characters. Authorizes POST /api/internal/notifications/send.
# Configure an external scheduler to call it periodically (see docs/HANDOFF.md).
NOTIFICATION_JOB_SECRET=""
